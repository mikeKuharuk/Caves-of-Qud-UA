<!--
  Compile check for the mod's C# (mod/Grammar, mod/Patches) without starting the game:
    dotnet build tools/grammar-build
  The game compiles the mod's .cs files itself; this project mirrors its setup
  (CoQ_Data/StreamingAssets/Base/Mods.csproj.template.txt: netstandard2.0, C# 9, the game's own assemblies).
  Set QudLibPath if the game is installed elsewhere.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CavesOfQudUA.Grammar</AssemblyName>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <QudLibPath Condition="'$(QudLibPath)' == ''">D:\Steam\steamapps\common\Caves of Qud\CoQ_Data\Managed</QudLibPath>
    <NoWarn>$(NoWarn);CS1701;CS1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../mod/**/*.cs" />
    <Reference Include="$(QudLibPath)\*.dll" Private="false" />
  </ItemGroup>
</Project>
