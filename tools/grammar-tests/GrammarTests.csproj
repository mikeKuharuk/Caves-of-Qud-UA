<!--
  Tests for the game-independent part of mod/Grammar. Run from the repository root:
    dotnet run (with the option project set to tools/grammar-tests)
  A plain console runner, so it needs no NuGet packages; exit code 1 on a failure.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../mod/Grammar/UkrainianForms.cs" />
    <Compile Include="../../mod/Grammar/UkrainianWords.cs" />
    <Compile Include="../../mod/Grammar/UkrainianNumbers.cs" />
    <Compile Include="../../mod/Grammar/UkrainianTerms.cs" />
    <Compile Include="../../mod/Grammar/UkrainianWordTools.cs" />
    <Compile Include="../../mod/Grammar/UkrainianThings.cs" />
    <Compile Include="../../mod/Grammar/UkrainianLaterality.cs" />
    <Compile Include="Tests.cs" />
  </ItemGroup>
</Project>
